{
  "uid": "collabdocs",
  "title": "CollabDocs cluster",
  "tags": [
    "collabdocs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
