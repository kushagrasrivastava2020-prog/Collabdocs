{
  "name": "collabdocs",
  "private": true,
  "version": "1.0.0",
  "description": "Real-time collaborative document editor built on Yjs CRDTs",
  "workspaces": [
    "server",
    "client",
    "loadtest",
    "e2e"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client && npm run build --workspace server",
    "start": "npm run start --workspace server",
    "test": "npm test --workspace server --workspace client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "loadtest": "npm run start --workspace loadtest --",
    "seed": "npm run seed --workspace loadtest --",
    "bot": "npm run bot --workspace loadtest --",
    "cluster:up": "docker compose up -d --build --wait",
    "cluster:down": "docker compose down",
    "test:e2e": "npm test --workspace e2e",
    "capture": "npm run capture --workspace e2e --",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
